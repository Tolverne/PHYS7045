Cell["Harmonic Oscillator", "Subsubsection",
 CellChangeTimes->{{3.938204303408081*^9, 
  3.938204306234096*^9}},ExpressionUUID->"be36c571-3b81-4024-870b-\
3a442a525ae9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HamHO", "=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "Ec"}], " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "2"}], "}"}]], "#"}]}], "+", 
     RowBox[{"EL", " ", 
      SuperscriptBox["\[Phi]", "2"], "#"}]}], "&"}], ")"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"f1ec6183-ebee-4142-adf6-94cf97bd9ed7"],

