Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"solHO", "=", 
  RowBox[{"NDEigensystem", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"HamHO", "[", 
        RowBox[{"\[Psi]", "[", "\[Phi]", "]"}], "]"}], "/.", "const"}], ",", 
      RowBox[{
       RowBox[{"\[Psi]", "[", 
        RowBox[{"-", "10"}], "]"}], "==", 
       RowBox[{"\[Psi]", "[", "10", "]"}]}]}], "}"}], ",", "\[Psi]", ",", 
    RowBox[{"{", 
     RowBox[{"\[Phi]", ",", 
      RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "10", ",", 
    RowBox[{"Method", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<PDEDiscretization\>\"", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<FiniteElement\>\"", ",", 
         RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<MaxCellMeasure\>\"", "\[Rule]", "0.25"}], "}"}]}]}], 
        "}"}]}], "}"}]}]}], "]"}]}]], "Input",
