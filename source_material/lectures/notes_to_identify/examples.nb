 RowBox[{
  RowBox[{"EL", " ", 
   SuperscriptBox["\[Phi]", "2"], " ", 
   RowBox[{"\[Psi]", "[", "\[Phi]", "]"}]}], "-", 
  RowBox[{"Ec", " ", 
   RowBox[{
    SuperscriptBox["\[Psi]", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "\[Phi]", "]"}]}]}]], "Output",
