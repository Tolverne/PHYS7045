Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "EJ"}], " ", 
   RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
   RowBox[{"\[Psi]", "[", "\[Phi]", "]"}]}], "-", 
  RowBox[{"Ec", " ", 
   RowBox[{
    SuperscriptBox["\[Psi]", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "\[Phi]", "]"}]}]}]], "Output",
