 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"-", "Ec"}], " ", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"{", 
       RowBox[{"\[Phi]", ",", "2"}], "}"}]], "#1"}]}], "-", 
