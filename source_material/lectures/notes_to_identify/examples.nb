Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"solJJ", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"NDEigensystem", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"HamJJ", "[", 
           RowBox[{"\[Psi]", "[", "\[Phi]", "]"}], "]"}], "/.", "constJJ"}], 
         ",", 
         RowBox[{
          RowBox[{"\[Psi]", "[", 
           RowBox[{"-", "\[Pi]"}], "]"}], "==", 
          RowBox[{"\[Psi]", "[", "\[Pi]", "]"}]}]}], "}"}], ",", "\[Psi]", 
       ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", 
         RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", "10", ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<PDEDiscretization\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<FiniteElement\>\"", ",", 
            RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<MaxCellMeasure\>\"", "\[Rule]", "0.25"}], 
              "}"}]}]}], "}"}]}], "}"}]}]}], "]"}], "//", "Transpose"}], "//",
