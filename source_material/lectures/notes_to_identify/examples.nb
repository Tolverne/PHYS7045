Cell[CellGroupData[{

Cell["Josephson nonlinear circtuit", "Subsubsection",
 CellChangeTimes->{{3.9382043124671907`*^9, 
  3.938204319810028*^9}},ExpressionUUID->"95f072db-8fe7-4d00-b73b-\
ef13f50e447a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HamJJ", "=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "Ec"}], " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "2"}], "}"}]], "#"}]}], "-", 
     RowBox[{"EJ", " ", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}], "#"}]}], "&"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.9382043283143997`*^9, 3.938204339827704*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"5bdf79c6-7472-4d71-bac1-d9d51a3442b7"],

