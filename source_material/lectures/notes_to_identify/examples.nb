Cell[BoxData[
 RowBox[{
  RowBox[{"const", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Ec", "->", "1"}], ",", 
     RowBox[{"EL", "->", "1"}]}], "}"}]}], ";"}]], "Input",
