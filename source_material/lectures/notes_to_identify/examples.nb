 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"-", "Ec"}], " ", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"{", 
       RowBox[{"\[Phi]", ",", "2"}], "}"}]], "#1"}]}], "+", 
   RowBox[{"EL", " ", 
    SuperscriptBox["\[Phi]", "2"], " ", "#1"}]}], "&"}]], "Output",
 CellChangeTimes->{3.938200482544129*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"38ce8b49-b021-46aa-8b40-bda720078623"]
}, Open  ]],

