Cell[BoxData[
 RowBox[{
  RowBox[{"constJJ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Ec", "->", "1"}], ",", 
     RowBox[{"EJ", "->", "2"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.938200545847954*^9, 3.938200555752239*^9}, {
