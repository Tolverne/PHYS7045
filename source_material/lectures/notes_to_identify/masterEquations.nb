Cell["Define the von Neumann equations componentwise", "Text",
 CellChangeTimes->{{3.997303861599169*^9, 
  3.997303897016111*^9}},ExpressionUUID->"c648749d-a772-461d-a1e6-\
0ce958cb1f15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"vNequations", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"\[CapitalRho]", "'"}], "[", "t", "]"}], "]"}], "==", 
    RowBox[{"Flatten", "[", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"Commute", "[", " ", 
        RowBox[{
         RowBox[{
          FractionBox["\[CapitalDelta]", "2"], "Z"}], ",", 
         RowBox[{"\[CapitalRho]", "[", "t", "]"}]}], "]"}]}], ")"}], "]"}]}], 
   "//", "Thread"}]}]], "Input",
 CellChangeTimes->{{3.997301565091484*^9, 3.997301580727944*^9}, {
  3.99730161277514*^9, 3.99730164313591*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"da9dd055-f028-4d58-956a-ca9e8dd44816"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Rho]", 
       RowBox[{"g", ",", "g"}]], "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "\[Equal]", "0"}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Rho]", 
       RowBox[{"g", ",", "e"}]], "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[CapitalDelta]", " ", 
     RowBox[{
      SubscriptBox["\[Rho]", 
       RowBox[{"g", ",", "e"}]], "[", "t", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Rho]", 
       RowBox[{"e", ",", "g"}]], "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
    RowBox[{"\[ImaginaryI]", " ", "\[CapitalDelta]", " ", 
     RowBox[{
      SubscriptBox["\[Rho]", 
       RowBox[{"e", ",", "g"}]], "[", "t", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Rho]", 
       RowBox[{"e", ",", "e"}]], "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "\[Equal]", "0"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.997301613064267*^9, 3.997301643398962*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"b7320155-2792-4923-97d2-e599a507d06a"]
}, Open  ]],

