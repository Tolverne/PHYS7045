Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"initequs", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"\[CapitalRho]", "[", "0", "]"}], "]"}], "==", 
    RowBox[{"Flatten", "[", 
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"a", "b"},
        {"c", "d"}
       }], "\[NoBreak]", ")"}], "]"}]}], "//", "Thread"}]}]], "Input",
 CellChangeTimes->{{3.997301715716427*^9, 3.997301760208373*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"e1b7ba06-fe42-4728-a174-87db29783eaa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", 
      RowBox[{"g", ",", "g"}]], "[", "0", "]"}], "\[Equal]", "a"}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", 
      RowBox[{"g", ",", "e"}]], "[", "0", "]"}], "\[Equal]", "b"}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", 
      RowBox[{"e", ",", "g"}]], "[", "0", "]"}], "\[Equal]", "c"}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", 
      RowBox[{"e", ",", "e"}]], "[", "0", "]"}], "\[Equal]", "d"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.997301760468059*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"bb257ec6-fcde-43e5-b9b5-633d153c8de7"]
}, Open  ]],

Cell["Solve the vN equations with Mathematica DSolve", "Text",
 CellChangeTimes->{{3.997303912302926*^9, 
  3.997303929164604*^9}},ExpressionUUID->"47e66fed-ae15-4254-a795-\
d2f1d594315a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"solvN", "=", 
  RowBox[{
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
